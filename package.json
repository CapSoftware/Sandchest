{
  "name": "sandchest",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "indexer:build": "cargo build --release -p sandchest-indexer",
    "scan": "bun run --cwd packages/engine scan"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
