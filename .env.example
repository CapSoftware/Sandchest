# Public URLs used by the landing page
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_URL=

# Model endpoint (/chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: a model per role. The default (LLM_MODEL) does every role, and the
# abliterated model is measurably the most RELIABLE skeptic: over 144 labelled
# real findings it kept 99% and disagreed with itself on only 3, versus a
# stronger stock reasoning model that kept 80%, dropped real findings, and
# disagreed with itself on 83/144. So keep the skeptic on the default model.
# These knobs exist for self-hosting and future experiments; measure on the
# labelled set (bun run reverify --repeat N) before changing a role's model.
LLM_MODEL_RECON=
LLM_MODEL_HUNT=
LLM_MODEL_SKEPTIC=
LLM_MODEL_STRUCTURE=
# Optional: sampling (unset = the endpoint's default). Pinning these does not make
# scans reproducible — the variance is structural to multi-turn agents, not sampling.
LLM_TEMPERATURE=
LLM_SEED=

# Optional: a typed-decision classifier (a fast model that returns a calibrated
# probability or a chosen option per question, never prose). When all three are
# set, deep scans recover HTTP handlers the indexer's framework-specific route
# rules missed and score each handler's authorization, so recon, the
# reachability proof and the peer-consistency check work on frameworks the route
# detector cannot see. Unset: the stage is skipped and scans run unchanged.
# LLM_CLASSIFIER_URL is the full POST endpoint; the body is a typed-decision
# protocol: { model, state, questions } -> { answers }.
LLM_CLASSIFIER_URL=
LLM_CLASSIFIER_KEY=
LLM_CLASSIFIER_MODEL=
# Optional: header name that opts a single oversized request into long context.
LLM_CLASSIFIER_LONG_CONTEXT_HEADER=
# Optional: the classifier's price in USD per million input tokens, to report what its calls cost.
LLM_CLASSIFIER_PRICE_INPUT=

# Postgres. The app's role only needs to read and write rows; migrations can
# use a separate role that may change the schema.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Optional: a transaction-mode pooler (PgBouncer) for the app's queries. Defaults to DATABASE_URL.
# Migrations and the self-hosted workflow World always connect directly.
DATABASE_POOLER_URL=

# Optional: model prices in USD per million tokens, to report the cost of each scan
LLM_PRICE_INPUT=
LLM_PRICE_CACHED_INPUT=
LLM_PRICE_OUTPUT=

# Optional: path to the sandchest-index binary (default: the cargo release build)
SANDCHEST_INDEXER_BIN=

# GitHub App (M2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Public URL of this deployment, for links in Checks and comments
SANDCHEST_APP_URL=
# Bearer token for operator-only routes (manual deep scans and any scan's live feed)
SANDCHEST_ADMIN_TOKEN=

# Dashboard sign-in uses the GitHub App's own OAuth client (App settings → Client ID / Generate a new
# client secret). Set the App's callback URL to <SANDCHEST_APP_URL>/api/auth/callback/github, its setup
# URL to <SANDCHEST_APP_URL>/dashboard, and give it the "Email addresses: read" account permission.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's URL name, for install links: github.com/apps/<slug>
GITHUB_APP_SLUG=
# Signs sessions and encrypts stored GitHub tokens: 32+ random characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Email: Resend in the cloud, or SMTP when self-hosting. Leave both empty to send no email.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=
# Billing (Autumn). Leave empty to turn billing off: nothing is limited, as when self-hosting.
# Plans live in packages/billing/autumn/autumn.config.ts: `bun run --cwd packages/billing autumn:push`.
AUTUMN_SECRET_KEY=
# Signing secret (whsec_...) of the Autumn webhook for <SANDCHEST_APP_URL>/api/autumn/webhooks: auto top-up
# emails and plan changes. `autumn:push` creates the webhook and writes the secret to the env file it uses.
AUTUMN_WEBHOOK_SECRET=
# Optional: the keys of the Stripe account Autumn bills through. With both set, a first plan is paid for on the
# page (Stripe's Payment Element) instead of on Stripe Checkout. A restricted key needs write access to
# Customers and SetupIntents.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Used only by `autumn:push`: where live Autumn sends events (default: production), and where the sandbox
# does. Without a sandbox URL the sandbox gets no webhook, so a sandbox push never points at production.
AUTUMN_WEBHOOK_URL_LIVE=
AUTUMN_WEBHOOK_URL_SANDBOX=
# Vercel Cron authentication for /api/cron/*
CRON_SECRET=
# Where scans run: "sandbox" (default on Vercel), "local" (default elsewhere) or "boat" (a boat.dev sandbox)
SANDCHEST_WORKSPACE=
# Boat only: API key (required), machine size (small, default, large, xlarge; default "default"), and seconds
# before an abandoned sandbox stops itself (default: the scan budget)
SANDCHEST_BOAT_API_KEY=
SANDCHEST_BOAT_TYPE=
SANDCHEST_BOAT_TTL_SECONDS=
# Model gateway for agents inside a sandbox (/api/gateway): a secret of 32+ characters that signs their
# tokens. Unset means the gateway is off. It forwards to LLM_AGENT_BASE_URL, LLM_AGENT_API_KEY and
# LLM_AGENT_MODEL (each defaults to its LLM_* setting), which must accept the messages format and report
# each call's cost in its usage. LLM_AGENT_BODY is an optional JSON object of fields set on every request.
SANDCHEST_GATEWAY_SECRET=
LLM_AGENT_BASE_URL=
LLM_AGENT_API_KEY=
LLM_AGENT_MODEL=
LLM_AGENT_BODY=
# Deep scan engine: "classic" (default) or "slice". The slice engine needs SANDCHEST_WORKSPACE=boat, the gateway
# secret above and a ceiling. SANDCHEST_ENGINE_ORGS limits it to these GitHub accounts (comma-separated).
SANDCHEST_ENGINE=
SANDCHEST_ENGINE_ORGS=
# The most one slice scan may cost in model and sandbox spend, in USD. Keep the value out of the repo.
SANDCHEST_SLICE_CEILING_USD=
# Optional JSON object of fields set on the slice engine's own model requests (it uses the LLM_AGENT_* endpoint).
LLM_SLICE_BODY=
# Indexer for sandboxes: a static x86_64 Linux build, as a file or a release download + sha256
SANDCHEST_INDEXER_LINUX_BIN=
SANDCHEST_INDEXER_LINUX_URL=
SANDCHEST_INDEXER_LINUX_SHA256=
# Codes that give free credits when typed into "Have a code?" at checkout, comma-separated, any case
# (4-64 letters, digits, dashes, underscores; anything else is ignored). Billing only. Keep them out of the repo.
SANDCHEST_FREE_CREDIT_CODES=
# Error reporting to Sentry (or anything that speaks its envelope protocol). Optional; nothing is sent by default.
# SENTRY_DSN reports server errors. NEXT_PUBLIC_SENTRY_DSN, read at build time, adds a small inline reporter (about 4 KB gzipped per page)
# to every page; leave it empty and pages carry no Sentry code at all. Events never include request bodies,
# headers, cookies, source code, finding contents or personal data. No tracing, no session replay.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: tag events with an environment (default: VERCEL_ENV or NODE_ENV)
SENTRY_ENVIRONMENT=
