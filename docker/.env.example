# Sandchest, self-hosted. Copy to docker/.env and fill in the required values:
#   cp .env.example .env
# Compose refuses to start, naming the setting, while a required value is empty.
# Generate secrets with: openssl rand -hex 32

# ---- Required -------------------------------------------------------------------------------------

# The public URL GitHub sends webhooks to and people open in their browser: your domain, or a tunnel's
# URL for a trial. No trailing slash.
SANDCHEST_APP_URL=

# Signs sign-in sessions, encrypts stored GitHub tokens and derives the setup link's token.
BETTER_AUTH_SECRET=

# The database password. Letters and digits only (it goes into a URL); openssl rand -hex 32 is ideal.
# Set it before the first start: the database keeps the password it was created with.
POSTGRES_PASSWORD=

# The model: any endpoint speaking the standard chat-completions protocol. The base URL includes the version
# segment, e.g. https://models.example.com/v1. The model needs tool calls, strict JSON-schema output
# and streaming. For an endpoint without keys, set LLM_API_KEY to any value.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- GitHub App -----------------------------------------------------------------------------------
# Leave these empty on the first start. The setup page creates the App and shows these lines once:
# paste them here, then run `docker compose up -d` again.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# ---- Optional -------------------------------------------------------------------------------------

# Where the server listens on this machine. Loopback by default: put a tunnel or a reverse proxy
# with TLS in front. 0.0.0.0 listens on every interface.
SANDCHEST_BIND=127.0.0.1
SANDCHEST_PORT=3000

# Use your own setup token (24+ characters) instead of the one derived from BETTER_AUTH_SECRET.
SANDCHEST_SETUP_TOKEN=

# Bearer token for operator routes: POST /api/scans starts a deep scan of "owner/name".
SANDCHEST_ADMIN_TOKEN=

# Email about critical findings and finished deep scans, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=

# Error reports to your own Sentry project. Nothing is sent anywhere else.
SENTRY_DSN=

# Model list prices in USD per million tokens, so each scan records what it cost.
LLM_PRICE_INPUT=
LLM_PRICE_CACHED_INPUT=
LLM_PRICE_OUTPUT=

# A prebuilt image instead of building from this checkout.
SANDCHEST_IMAGE=sandchest:local
